meta {
  name: Create user
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/users
  body: json
  auth: inherit
}

body:json {
  {
    "email": "test@test.com",
    "name": "test",
    "password": "testtest"
  }
}

vars:post-response {
  userId: res.body.id
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
