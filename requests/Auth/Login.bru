meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

vars:pre-request {
  email: john@doe.com
  password: testtest
}

vars:post-response {
  accessToken: res.body.access_token
  refreshToken: res.body.refresh_token
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
