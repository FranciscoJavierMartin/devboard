meta {
  name: Create task
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/tasks
  body: json
  auth: inherit
}

body:json {
  {
    "project_id": "project_1",
    "title": "Polaris"
  }
}

vars:post-response {
  taskId: res.body.id
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
