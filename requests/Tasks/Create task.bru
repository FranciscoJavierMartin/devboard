meta {
  name: Create task
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/tasks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "project_id": "431982c5-b8c7-4fd7-b04e-63484d97c6a8",
    "title": "Polaris",
    "description": "Description mock"
  }
}

vars:post-response {
  taskId: res.body.id
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
